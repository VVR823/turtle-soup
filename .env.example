# 项目根目录环境变量模板（可选）
# config.py 优先读 backend/.env，未配置的变量才回退读项目根目录的 .env.local。
# 完整选项见 backend/.env.example（复制为 backend/.env 使用）。
# 默认离线测试不需要复制本文件，不会加载个人 dotenv。

# ===== LLM 供应商 =====
# 智谱免费模型示例；真实调用前仍需复核官方价格页。
# LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=你的key
# ZHIPU_MODEL=glm-4-flash-250414
# MODEL_FREE_VERIFIED=1
# FREE_MODEL_PROVIDER=zhipu
# FREE_MODEL_NAME=glm-4-flash-250414
# FREE_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 站点相关（可选）=====
# 站点访问口令：设一个字符串开启全站口令闸门（防 LLM 额度被白嫖）
# SITE_PASSWORD=你的口令
# 反馈管理后台口令：不设置则管理后台关闭（接口返回 503）
# ADMIN_TOKEN=你的管理口令
