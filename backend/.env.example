# 复制本文件为 .env 并填入你的密钥
# 也可直接复用项目根目录的 .env.local（config.py 会自动回退读取）
# 默认离线测试不需要本文件，不会读取个人 dotenv 或真实模型密钥。

# ===== LLM 供应商（三选一）=====
# 1) 本地 Ollama（0 成本，需本机跑 Ollama）
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b

# 2) 硅基流动 SiliconFlow（使用前核实具体模型/账户的免费资格）
# LLM_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=你的key
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# 3) 智谱 GLM（当前官方价格页标为免费；上线前仍应复核）
# LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=你的key
# ZHIPU_MODEL=glm-4-flash-250414

# 云模型须先核验当前账户/模型/地址的免费资格；不是永久免费证明。
# 未核验则网关拒绝云调用，不会自动换供应商或切收费模型。
# 以下值要与实际配置完全一致；不要在地址中嵌入密钥。
# MODEL_FREE_VERIFIED=1
# FREE_MODEL_PROVIDER=zhipu
# FREE_MODEL_NAME=glm-4-flash-250414
# FREE_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 部署相关 =====
# 上线时填前端域名（逗号分隔），否则仅允许 localhost
# CORS_ORIGINS=https://xxx.vercel.app

# 站点访问口令：设一个字符串开启全站口令闸门（防 LLM 额度被白嫖）
# SITE_PASSWORD=你的口令

# 反馈管理后台口令（独立于站点口令）：不设置则管理后台关闭（接口返回 503）。
# 需要后台时设一个强口令，前端访问 /admin/feedback 时输入它即可。
# ADMIN_TOKEN=你的管理口令

# 仅在确认直接反代 peer 后配置；默认不信任客户端转发头，禁止 0.0.0.0/0 或 ::/0。
# TRUSTED_PROXY_CIDRS=127.0.0.1/32
# 既定运行基线：scripts/run-backend.py 显式只启一个 API worker，不让 uvicorn 先改写 peer。
API_WORKER_COUNT=1
# TS-14 前没有持久化 Agent worker；本开关默认关闭，多 API worker 不允许启用。
ENABLE_AGENT=0
